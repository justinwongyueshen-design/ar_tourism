# Uploaded files are static images ONLY. Never execute anything here.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh|shtml|html?|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
RemoveHandler .php .phtml .phar
